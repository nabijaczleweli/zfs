#ifneq ($(KBUILD_EXTMOD),)
#src = @abs_srcdir@
#obj = @abs_builddir@
#endif

#MODULE := zcommon

#obj-$(CONFIG_ZFS) := $(MODULE).o

# Suppress unused-value warnings in sparc64 architecture headers
ccflags-$(CONFIG_SPARC64) += -Wno-unused-value

$(MODULE)-objs += ../zcommon/cityhash.o
$(MODULE)-objs += ../zcommon/zfeature_common.o
$(MODULE)-objs += ../zcommon/zfs_comutil.o
$(MODULE)-objs += ../zcommon/zfs_deleg.o
$(MODULE)-objs += ../zcommon/zfs_fletcher.o
$(MODULE)-objs += ../zcommon/zfs_fletcher_superscalar.o
$(MODULE)-objs += ../zcommon/zfs_fletcher_superscalar4.o
$(MODULE)-objs += ../zcommon/zfs_namecheck.o
$(MODULE)-objs += ../zcommon/zfs_prop.o
$(MODULE)-objs += ../zcommon/zpool_prop.o
$(MODULE)-objs += ../zcommon/zprop_common.o

$(MODULE)-$(CONFIG_X86) += ../zcommon/zfs_fletcher_intel.o
$(MODULE)-$(CONFIG_X86) += ../zcommon/zfs_fletcher_sse.o
$(MODULE)-$(CONFIG_X86) += ../zcommon/zfs_fletcher_avx512.o
$(MODULE)-$(CONFIG_ARM64) += ../zcommon/zfs_fletcher_aarch64_neon.o
